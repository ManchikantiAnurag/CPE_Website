---
import "../styles/global.css";
import Header from "../components/Base/Header/Header.astro";
import Footer from "../components/Base/Footer/Footer.astro";
import Toast from "../components/Base/Toast/Toast.astro";
import { getSiteSettings } from "../lib/site";

interface Props {
    title?: string;
    description?: string;
    /** Which cross-document view transition this page arrives with. */
    transition?: "fade" | "lift" | "slide";
}

const site = await getSiteSettings();
const {
    title,
    description = site.description,
    transition = "lift",
} = Astro.props;
const pageTitle = title ? `${title} | ${site.college_name}` : site.college_name;
---

<!doctype html>
<html lang="en" data-page-transition={transition}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{pageTitle}</title>
        <!-- Marks JS as available before first paint, so the reveal styles
             only hide content that something is going to bring back. If the
             reveal script never arrives, drop the flag so nothing stays
             invisible — an unanimated page beats a blank one. -->
        <script is:inline>
            document.documentElement.classList.add("js");
            setTimeout(() => {
                if (!window.__revealReady)
                    document.documentElement.classList.remove("js");
            }, 3000);
        </script>
    </head>
    <body class="flex min-h-screen flex-col bg-background text-foreground">
        <Header />
        <main class="flex-1">
            <slot />
        </main>
        <Footer />
        <Toast />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
</style>
