---
import "../styles/global.css";
import Header from "../components/Base/Header/Header.astro";
import Footer from "../components/Base/Footer/Footer.astro";
import { getSiteSettings } from "../lib/site";

interface Props {
    title?: string;
    description?: string;
}

const site = await getSiteSettings();
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.college_name}` : site.college_name;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{pageTitle}</title>
    </head>
    <body class="flex min-h-screen flex-col bg-background text-foreground">
        <Header />
        <main class="flex-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
</style>
