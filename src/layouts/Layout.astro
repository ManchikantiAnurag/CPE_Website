---
import "../styles/global.css";
import { SEO } from "astro-seo";
import logo from "../assets/media/logo.png";
import Header from "../components/Base/Header/Header.astro";
import Footer from "../components/Base/Footer/Footer.astro";
import Toast from "../components/Base/Toast/Toast.astro";
import { getContactDetails, getSiteSettings } from "../lib/site";

interface Props {
    title?: string;
    description?: string;
    transition?: "fade" | "lift" | "slide";
    headerBackground?: "default" | "hero";
    structuredData?: Record<string, unknown>;
}

const site = await getSiteSettings();
const contact = await getContactDetails();
const {
    title,
    description = site.description,
    transition = "lift",
    headerBackground = "default",
    structuredData,
} = Astro.props;
const pageTitle = title?.includes(site.college_name)
    ? title
    : title ? `${title} | ${site.college_name}` : site.college_name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogName = Astro.url.pathname === "/"
    ? "home"
    : Astro.url.pathname.replace(/^\/+|\/+$/g, "").replaceAll("/", "-");
const ogImage = new URL(`/og/${ogName}.png`, Astro.site);
const organizationId = new URL("/#organization", Astro.site).href;
const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "EducationalOrganization",
            "@id": organizationId,
            name: site.college_name,
            url: Astro.site!.href,
            logo: new URL(logo.src, Astro.site).href,
            description: site.description,
            foundingDate: String(site.established_year),
            telephone: contact.phone_numbers.map((phone) => `+91${phone}`),
            email: contact.emails,
            address: {
                "@type": "PostalAddress",
                streetAddress: Object.values(contact.address).filter(Boolean).join(", "),
                addressCountry: "IN",
            },
        },
        {
            "@type": "WebSite",
            "@id": new URL("/#website", Astro.site).href,
            name: site.college_name,
            url: Astro.site!.href,
            publisher: { "@id": organizationId },
        },
        ...(structuredData ? [structuredData] : []),
    ],
};
---

<!doctype html>
<html lang="en" data-page-transition={transition}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=cpe-2" />
        <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=cpe-2" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Fraunces:wght@600&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <SEO
            title={pageTitle}
            description={description}
            canonical={canonical}
            openGraph={{
                basic: {
                    title: pageTitle,
                    type: "website",
                    image: ogImage.href,
                    url: canonical,
                },
                optional: { description, siteName: site.college_name },
                image: { width: 1200, height: 630 },
            }}
            twitter={{
                card: "summary_large_image",
                title: pageTitle,
                description,
                image: ogImage,
            }}
        />
        <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
        <!-- Recover visible content if the reveal script never loads. -->
        <script is:inline>
            document.documentElement.classList.add("js");
            setTimeout(() => {
                if (!window.__revealReady)
                    document.documentElement.classList.remove("js");
            }, 3000);
        </script>
    </head>
    <body class="flex min-h-screen flex-col bg-background text-foreground">
        <!-- Header and the page hero share one bg-hero box so the cover image
             renders once across both, instead of restarting at the hero edge. -->
        <div class="bg-hero">
            <Header background={headerBackground} />
            <div class="overflow-x-clip">
                <slot name="hero" />
            </div>
        </div>
        <main class="flex-1 overflow-x-clip">
            <slot />
        </main>
        <Footer />
        <Toast />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
</style>
