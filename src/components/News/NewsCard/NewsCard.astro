---
import { Icon } from "astro-icon/components";
import Figure from "../../Base/Figure/Figure.astro";

interface Props {
    title: string;
    categoryName: string;
    date: string;
    summary: string;
    image?: string;
    imageAlt: string;
    link?: { label?: string; href?: string };
}

const { title, categoryName, date, summary, image, imageAlt, link } =
    Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
}).format(new Date(date));
---

<article class="flex h-full flex-col border border-border bg-card">
    <Figure src={image} alt={imageAlt} width={800} height={600} />

    <div class="flex flex-1 flex-col p-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span
                class="text-[11px] font-semibold uppercase tracking-widest text-accent"
            >
                {categoryName}
            </span>
            <time datetime={date} class="text-xs text-muted-foreground">
                {formattedDate}
            </time>
        </div>

        <h3 class="mt-3 text-lg text-primary">{title}</h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
            {summary}
        </p>

        {
            link?.href && (
                <a
                    href={link.href}
                    class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent"
                >
                    {link.label || "Read More"}
                    <Icon
                        name="lucide:arrow-right"
                        class="h-4 w-4"
                        aria-hidden="true"
                    />
                </a>
            )
        }
    </div>
</article>

<style>
    article {
        position: relative;
    }

    a::after {
        position: absolute;
        inset: 0;
        content: "";
    }

    a:focus-visible {
        outline: none;
    }

    a:focus-visible::after {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
    }
</style>
