---
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
    items: string[];
}

const { title, items } = Astro.props;
---

<div>
    <div class="flex items-center gap-3">
        <Icon
            name="lucide:calendar-days"
            class="h-6 w-6 text-accent"
            aria-hidden="true"
        />
        <h3 class="text-xl text-primary">{title}</h3>
    </div>

    <ul class="mt-5 space-y-3">
        {
            items.map((item) => (
                <li class="border-l-2 border-accent pl-4 text-sm text-muted-foreground">
                    {item}
                </li>
            ))
        }
    </ul>
</div>
