---
import Button from "../../Base/Button/Button.astro";
import Field from "../../Base/Field/Field.astro";
import Input from "../../Base/Input/Input.astro";
import Select from "../../Base/Select/Select.astro";
import Textarea from "../../Base/Textarea/Textarea.astro";

interface Props {
    title: string;
    description: string;
    submitLabel: string;
    courses: { value: string; label: string }[];
    action?: string;
    variant?: "default" | "course";
}

const { title, description, submitLabel, courses, action, variant = "default" } = Astro.props;
---

<form
    method="post"
    action={action || "/api/form"}
    data-toast="Thank you. Your enquiry has been submitted — our admissions team will call you shortly."
    class:list={[
        "grid gap-6 rounded-[20px] border border-border bg-card p-8 md:grid-cols-2 md:p-10",
        variant === "course" && "course-enquiry",
    ]}
>
    <div class="enquiry-heading md:col-span-2">
        <h2 class="text-3xl text-primary md:text-[32px]">{title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{description}</p>
    </div>

    <Field label="Student Name" for="student_name" required>
        <Input id="student_name" maxlength={100} required />
    </Field>

    <Field label="Parent Name" for="parent_name">
        <Input id="parent_name" maxlength={100} />
    </Field>

    <Field label="Mobile Number" for="mobile" required>
        <Input id="mobile" type="tel" maxlength={15} required />
    </Field>

    <Field label="Email" for="email">
        <Input id="email" type="email" maxlength={255} />
    </Field>

    <Field label="Course Interested In" for="course" full>
        <Select id="course" placeholder={variant === "course" ? "Select" : "Select a course"} options={courses} />
    </Field>

    <Field label="Message" for="message" full>
        <Textarea id="message" maxlength={1000} />
    </Field>

    <div class="md:col-span-2">
        <Button variant="accent" size="lg">{submitLabel}</Button>
    </div>
</form>

<style>
    .course-enquiry {
        gap: 40px 32px;
        padding: 40px;
    }

    .course-enquiry .enquiry-heading {
        margin-bottom: 16px;
    }

    .course-enquiry h2 {
        color: #0f172a;
        font-size: 32px;
        line-height: 40px;
    }

    .course-enquiry .enquiry-heading p {
        margin-top: 20px;
        color: #475569;
        font-size: 16px;
        line-height: 24px;
    }

    .course-enquiry :global(label) {
        display: block;
        font-size: 18px;
        font-weight: 400;
        line-height: 24px;
    }

    .course-enquiry :global(input),
    .course-enquiry :global(select),
    .course-enquiry :global(textarea) {
        border: 1px solid #d9d9d9;
        border-radius: 4px;
        font-size: 16px;
    }

    .course-enquiry :global(button) {
        width: 240px;
        height: 60px;
        margin-top: 20px;
        border-radius: 4px;
        background: #dc2626;
    }

    @media (max-width: 639px) {
        .course-enquiry {
            gap: 24px;
            padding: 24px;
        }

        .course-enquiry h2 {
            font-size: 28px;
            line-height: 36px;
        }

        .course-enquiry :global(button) {
            width: 100%;
            margin-top: 0;
        }
    }
</style>
