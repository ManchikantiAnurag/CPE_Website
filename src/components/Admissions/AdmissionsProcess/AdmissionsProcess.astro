---
import SectionHeading from "../../Base/SectionHeading/SectionHeading.astro";

interface Props {
    eyebrow: string;
    title: string;
    steps: string[];
}

const { eyebrow, title, steps } = Astro.props;
---

<div>
    <SectionHeading eyebrow={eyebrow} title={title} />

    <ol class="mt-8 space-y-5">
        {
            steps.map((step, index) => (
                <li class="flex gap-4 border border-border bg-card p-5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center bg-primary font-display text-sm font-semibold text-primary-foreground">
                        {index + 1}
                    </span>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        {step}
                    </p>
                </li>
            ))
        }
    </ol>
</div>
