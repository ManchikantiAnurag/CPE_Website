---
import SectionHeading from "../../Base/SectionHeading/SectionHeading.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    steps: string[];
}

const { eyebrow, title, steps } = Astro.props;
---

<div>
    <SectionHeading eyebrow={eyebrow} title={title} />

    <Reveal as="ol" stagger={90} class="mt-8 space-y-5">
        {
            steps.map((step, index) => (
                <li class="flex gap-4 border border-border bg-card p-5">
                    <span class="flex h-[33px] w-[33px] shrink-0 items-center justify-center bg-accent font-hero text-[22px] font-semibold text-accent-foreground">
                        {index + 1}
                    </span>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        {step}
                    </p>
                </li>
            ))
        }
    </Reveal>
</div>
