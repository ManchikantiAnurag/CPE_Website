---
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
    phones: string[];
}

const { title, phones } = Astro.props;

const edge = "px-6 md:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] md:pr-6";
---

<section class="grid md:grid-cols-2">
    <div class:list={["flex items-center bg-highlight py-8", edge]}>
        <p class="font-hero text-2xl font-semibold text-primary">{title}</p>
    </div>
    <div class:list={["flex flex-wrap items-center gap-x-10 gap-y-3 bg-navy-deep py-8", edge]}>
        {
            phones.map((phone) => (
                <a
                    href={`tel:${phone}`}
                    class="inline-flex items-center gap-4 font-hero text-2xl font-semibold text-primary-foreground hover:opacity-80"
                >
                    <Icon
                        name="lucide:phone"
                        class="h-6 w-6"
                        aria-hidden="true"
                    />
                    {phone}
                </a>
            ))
        }
    </div>
</section>
