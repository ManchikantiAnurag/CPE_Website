---
import { Icon } from "astro-icon/components";
import Section from "../../Base/Section/Section.astro";

interface Props {
    title: string;
    phones: string[];
}

const { title, phones } = Astro.props;
---

<Section background="accent" bordered padded={false} class="py-0">
    <div class="flex flex-wrap items-center justify-between gap-6 py-8">
        <p class="font-display text-xl text-accent-foreground">{title}</p>
        <div class="flex flex-wrap gap-3">
            {
                phones.map((phone) => (
                    <a
                        href={`tel:${phone}`}
                        class="inline-flex items-center gap-2 bg-navy-deep px-5 py-3 text-base font-semibold text-primary-foreground hover:bg-navy-deep/90"
                    >
                        <Icon
                            name="lucide:phone"
                            class="h-4 w-4"
                            aria-hidden="true"
                        />
                        {phone}
                    </a>
                ))
            }
        </div>
    </div>
</Section>
