---
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";
import PeopleGrid from "../../Base/PeopleGrid/PeopleGrid.astro";
import SectionHeadingRow from "../../Base/SectionHeadingRow/SectionHeadingRow.astro";
import { getLeadership } from "../../../lib/site";

interface Props {
    eyebrow: string;
    title: string;
    cta: { label: string; href: string };
}

const { eyebrow, title, cta } = Astro.props;

const people = await getLeadership();
---

<SectionHeadingRow eyebrow={eyebrow} title={title}>
    <Button slot="action" href={cta.href} variant="outline">
        {cta.label}
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
    </Button>
</SectionHeadingRow>

<PeopleGrid people={people} class="mt-12" />
