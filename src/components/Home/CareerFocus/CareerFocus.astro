---
import FeatureTile from "../../Base/FeatureTile/FeatureTile.astro";
import SectionHeading from "../../Base/SectionHeading/SectionHeading.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    description: string;
    items: { title: string; description: string }[];
}

const { eyebrow, title, description, items } = Astro.props;
---

<div class="grid gap-12 lg:grid-cols-[1fr_1.35fr]">
    <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
    />

    <Reveal stagger={90} class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
        {
            items.map((item) => (
                <FeatureTile
                    icon="lucide:briefcase"
                    title={item.title}
                    description={item.description}
                    plain
                    compact
                />
            ))
        }
    </Reveal>
</div>

<style>
    :global(.career-section h2) { margin-top: 20px; }
    :global(.career-section h3) { margin-top: 14px; }
    :global(.career-section .grid > div > p) { line-height: 22px; }
</style>
