---
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";
import Figure from "../../Base/Figure/Figure.astro";

interface Props {
    eyebrow: string;
    title: string;
    paragraphs: string[];
    cta: { label: string; href: string };
    image?: string;
    imageAlt: string;
}

const { eyebrow, title, paragraphs, cta, image, imageAlt } = Astro.props;
---

<div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
    <Figure src={image} alt={imageAlt} width={1408} height={1008} />

    <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="mt-3 text-3xl text-primary md:text-4xl">{title}</h2>
        {
            paragraphs.map((paragraph, index) => (
                <p
                    class:list={[
                        index === 0 ? "mt-5" : "mt-4",
                        "text-base leading-relaxed text-muted-foreground",
                    ]}
                >
                    {paragraph}
                </p>
            ))
        }
        <Button href={cta.href} variant="outline" class="mt-8">
            {cta.label}
            <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </Button>
    </div>
</div>
