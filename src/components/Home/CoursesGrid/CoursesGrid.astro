---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";
import CourseCard from "../../Courses/CourseCard/CourseCard.astro";
import SectionHeadingRow from "../../Base/SectionHeadingRow/SectionHeadingRow.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    description: string;
    cta: { label: string; href: string };
}

const { eyebrow, title, description, cta } = Astro.props;

const courses = (await getCollection("courses")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<SectionHeadingRow eyebrow={eyebrow} title={title} description={description}>
    <Button slot="action" href={cta.href} variant="outline">
        {cta.label}
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
    </Button>
</SectionHeadingRow>

<Reveal stagger={90} class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
        courses.map((course) => (
            <CourseCard
                code={course.data.code}
                title={course.data.title}
                tagline={course.data.tagline}
                duration={course.data.duration}
                href={`/courses/${course.id}`}
            />
        ))
    }
</Reveal>
