---
import FeatureTile from "../../Base/FeatureTile/FeatureTile.astro";
import SectionHeading from "../../Base/SectionHeading/SectionHeading.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    items: { icon: string; title: string; description: string }[];
}

const { eyebrow, title, items } = Astro.props;
---

<SectionHeading eyebrow={eyebrow} title={title} />

<!-- gap-px over a bordered background draws the hairline grid between tiles. -->
<Reveal
    stagger={90}
    class="mt-12 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
>
    {
        items.map((item) => (
            <FeatureTile
                icon={item.icon}
                title={item.title}
                description={item.description}
            />
        ))
    }
</Reveal>
