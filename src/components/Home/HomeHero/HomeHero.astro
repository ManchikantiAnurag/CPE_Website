---
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";
import Figure from "../../Base/Figure/Figure.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Link {
    label: string;
    href: string;
}

interface Props {
    eyebrow: string;
    title: string;
    intro: string;
    primaryCta: Link;
    secondaryCta: Link;
    stats: { label: string; value: string }[];
    image?: string;
    imageAlt: string;
    badge?: string;
}

const {
    eyebrow,
    title,
    intro,
    primaryCta,
    secondaryCta,
    stats,
    image,
    imageAlt,
    badge,
} = Astro.props;

const courseShortcuts = [
    { label: "MEC", href: "/courses/cec", icon: "lucide:chart-no-axes-combined" },
    { label: "IPMAT", href: "/courses/ipmat", icon: "lucide:graduation-cap" },
    { label: "CLAT", href: "/courses/clat", icon: "lucide:scale" },
    { label: "CA/CMA", href: "/courses/mec", icon: "lucide:book-open" },
];
---

<section class="relative overflow-hidden bg-hero">
    <div
        class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-[1.05fr_1fr] lg:py-24"
    >
        <Reveal immediate stagger={90} duration={800}>
            <p class="eyebrow">{eyebrow}</p>
            <h1
                class="mt-5 text-4xl leading-[1.08] text-black md:text-5xl lg:text-[3.4rem]"
            >
                {title}
            </h1>
            <p
                class="mt-6 max-w-xl text-base leading-relaxed text-black md:text-lg"
            >
                {intro}
            </p>

            <div class="mt-9 flex flex-wrap gap-3">
                <Button href={primaryCta.href} variant="accent" size="lg">
                    {primaryCta.label}
                </Button>
                <Button
                    href={secondaryCta.href}
                    variant="outline"
                    size="lg"
                    class="border-accent! text-accent! hover:text-accent-foreground! [--fill-color:var(--color-accent)]!"
                >
                    {secondaryCta.label}
                </Button>
            </div>

            <nav class="mt-7 flex flex-wrap gap-3" aria-label="Course shortcuts">
                {courseShortcuts.map((course) => (
                    <a href={course.href} class="inline-flex items-center gap-2 rounded border border-black/20 px-4 py-2 text-sm font-medium text-black transition-colors hover:bg-white/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                        <Icon name={course.icon} class="h-4 w-4" aria-hidden="true" />
                        {course.label}
                    </a>
                ))}
            </nav>

            {
                stats.length > 0 && (
                    <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-black/20 pt-8">
                        {stats.map((stat) => (
                            <div>
                                <dt class="text-[11px] uppercase tracking-widest text-black">
                                    {stat.label}
                                </dt>
                                <dd class="mt-1 font-display text-2xl text-black">
                                    {stat.value}
                                </dd>
                            </div>
                        ))}
                    </dl>
                )
            }
        </Reveal>

        <Reveal variant="right" immediate delay={220} class="relative">
            <Figure
                src={image}
                alt={imageAlt}
                width={1600}
                height={1104}
                loading="eager"
                class="shadow-lift"
            />
            {
                badge && (
                    <div class="absolute -bottom-px left-0 hidden bg-accent px-6 py-4 text-accent-foreground sm:block">
                        <p class="font-display text-lg leading-none">{badge}</p>
                    </div>
                )
            }
        </Reveal>
    </div>
</section>
