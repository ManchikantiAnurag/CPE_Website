---
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";

interface Props {
    code: string;
    title: string;
    tagline: string;
    duration?: string;
    eligibility?: string;
    careers?: string[];
    href: string;
}

const {
    code,
    title,
    tagline,
    duration,
    eligibility,
    careers = [],
    href,
} = Astro.props;

// Reads as a sentence, e.g. "Law, Commerce and Management."
const careerList = careers.length
    ? `${new Intl.ListFormat("en-GB", { style: "long", type: "conjunction" }).format(careers)}.`
    : "";

const details = [
    { term: "Eligibility", description: eligibility },
    { term: "Career Opportunities", description: careerList },
].filter((detail) => Boolean(detail.description));
---

<article
    class="grid gap-6 border border-border bg-card p-6 sm:p-8 md:grid-cols-[129px_minmax(0,1fr)] md:gap-[51px] md:p-10"
>
    <div>
        <span class="block font-display text-4xl leading-tight text-primary md:text-[44px] md:leading-[56px]">
            {code}
        </span>
        {
            duration && (
                <p class="mt-3 max-w-[180px] text-[10px] font-bold uppercase leading-[18px] text-accent md:mt-[15px] md:max-w-none">
                    {duration}
                </p>
            )
        }
    </div>

    <div class="min-w-0">
        <h2 class="text-2xl text-primary sm:text-3xl md:text-4xl md:leading-10">{title}</h2>
        <p class="mt-5 text-base leading-6 text-slate-600">
            {tagline}
        </p>

        {
            details.length > 0 && (
                <dl class="mt-8 grid gap-6 md:mt-[34px] lg:grid-cols-2 lg:gap-[70px]">
                    {details.map((detail) => (
                        <div>
                            <dt class="text-base font-semibold uppercase leading-6 tracking-[1px] text-slate-600">
                                {detail.term}
                            </dt>
                            <dd class="mt-3 text-base leading-6 text-slate-600">
                                {detail.description}
                            </dd>
                        </div>
                    ))}
                </dl>
            )
        }

        <div class="mt-8 flex flex-wrap items-start gap-4 md:mt-12 md:gap-[22px]">
            <Button href={href} variant="outline" class="h-[42px] rounded-sm !border-slate-300 px-5 py-2.5 text-sm max-[360px]:w-full">
                Learn More
                <Icon
                    name="lucide:arrow-right"
                    class="h-4 w-4"
                    aria-hidden="true"
                />
            </Button>
            <Button href="/admissions" variant="accent" class="h-10 rounded-sm px-5 py-2.5 text-sm max-[360px]:w-full">Apply Now</Button>
        </div>
    </div>
</article>
