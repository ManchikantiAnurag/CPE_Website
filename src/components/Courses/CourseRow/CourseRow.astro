---
import { Icon } from "astro-icon/components";
import Button from "../../Base/Button/Button.astro";

interface Props {
    code: string;
    title: string;
    tagline: string;
    duration?: string;
    eligibility?: string;
    careers?: string[];
    href: string;
}

const {
    code,
    title,
    tagline,
    duration,
    eligibility,
    careers = [],
    href,
} = Astro.props;

const details = [
    { term: "Eligibility", description: eligibility },
    { term: "Career Opportunities", description: careers.join(", ") },
].filter((detail) => Boolean(detail.description));
---

<article
    class="grid gap-8 border border-border bg-card p-8 md:grid-cols-[130px_1fr] md:gap-12 md:p-10"
>
    <div>
        <span class="font-display text-[44px] leading-10 text-primary">
            {code}
        </span>
        {
            duration && (
                <p class="mt-4 text-[10px] font-bold uppercase leading-[18px] text-accent">
                    {duration}
                </p>
            )
        }
    </div>

    <div>
        <h2 class="text-3xl text-primary md:text-4xl">{title}</h2>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">
            {tagline}
        </p>

        {
            details.length > 0 && (
                <dl class="mt-8 grid gap-8 sm:grid-cols-2">
                    {details.map((detail) => (
                        <div>
                            <dt class="text-base font-semibold uppercase tracking-[1px] text-muted-foreground">
                                {detail.term}
                            </dt>
                            <dd class="mt-3 text-base leading-relaxed text-muted-foreground">
                                {detail.description}
                            </dd>
                        </div>
                    ))}
                </dl>
            )
        }

        <div class="mt-7 flex flex-wrap gap-3">
            <Button href={href} variant="outline" class="rounded">
                Learn More
                <Icon
                    name="lucide:arrow-right"
                    class="h-4 w-4"
                    aria-hidden="true"
                />
            </Button>
            <Button href="/admissions" variant="accent" class="rounded">Apply Now</Button>
        </div>
    </div>
</article>
