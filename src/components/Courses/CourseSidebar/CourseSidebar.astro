---
import Button from "../../Base/Button/Button.astro";
import DetailItem from "../../Base/DetailItem/DetailItem.astro";
import ContactLink from "../../Base/ContactLink/ContactLink.astro";

interface Props {
    duration?: string;
    eligibility?: string;
    board?: string;
    phones?: string[];
    emails?: string[];
}

const {
    duration,
    eligibility,
    board,
    phones = [],
    emails = [],
} = Astro.props;

const details = [
    { icon: "lucide:clock", term: "Duration", description: duration },
    { icon: "lucide:target", term: "Eligibility", description: eligibility },
    { icon: "lucide:graduation-cap", term: "Board", description: board },
].filter((detail) => Boolean(detail.description));
---

<aside class="h-fit rounded-[10px] border border-border bg-surface p-[30px]">
    <h2 class="text-3xl text-primary md:text-[32px]">Course Details</h2>

    {
        details.length > 0 && (
            <dl class="mt-8 space-y-7">
                {details.map((detail) => (
                    <DetailItem
                        icon={detail.icon}
                        term={detail.term}
                        description={detail.description!}
                    />
                ))}
            </dl>
        )
    }

    <Button href="/admissions" variant="accent" size="lg" class="mt-9 w-full rounded">
        Apply Now
    </Button>

    <div
        class="mt-4 flex flex-col items-center gap-1 text-sm text-muted-foreground"
    >
        {
            phones.map((phone) => (
                <ContactLink type="phone" value={phone} class="hover:text-accent" />
            ))
        }
        {
            emails.map((email) => (
                <ContactLink type="email" value={email} class="hover:text-accent" />
            ))
        }
    </div>
</aside>
