---
import { Icon } from "astro-icon/components";

interface Props {
    code: string;
    title: string;
    tagline: string;
    duration?: string;
    href: string;
}

const { code, title, tagline, duration, href } = Astro.props;
---

<article
    class="group flex h-full flex-col rounded-lg border border-border bg-card p-7 transition-all hover:border-primary/30 hover:shadow-lift duration-300"
>
    <div class="flex items-start justify-between gap-4">
        <span class="font-display text-2xl text-primary">
            {code}
        </span>
        {
            duration && (
                <span class="mt-1 border-l-2 border-accent pl-2 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    {duration}
                </span>
            )
        }
    </div>

    <h3 class="mt-4 font-sans text-sm font-bold text-primary">{title}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
        {tagline}
    </p>

    <a
        href={href}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent"
    >
        Learn More
        <Icon
            name="lucide:arrow-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-1 duration-300"
            aria-hidden="true"
        />
    </a>
</article>
