---
interface Props {
    overview: string;
    sections?: { heading: string; paragraphs: string[]; items: string[] }[];
}

const { overview, sections = [] } = Astro.props;
---

<div class="space-y-10">
    <section>
        <h2 class="text-3xl text-primary md:text-[32px]">Programme Overview</h2>
        <p class="mt-6 whitespace-pre-line text-base leading-relaxed text-muted-foreground">
            {overview}
        </p>
    </section>

    {
        sections.map((section) => (
            <section>
                <h2 class="text-3xl text-primary md:text-[32px]">{section.heading}</h2>
                {section.paragraphs.map((paragraph) => (
                    <p class="mt-6 text-base leading-relaxed text-muted-foreground">
                        {paragraph}
                    </p>
                ))}
                {section.items.length > 0 && (
                    <ul class="mt-6 list-disc space-y-3 pl-6 text-base leading-relaxed text-muted-foreground marker:text-muted-foreground">
                        {section.items.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                )}
            </section>
        ))
    }
</div>
