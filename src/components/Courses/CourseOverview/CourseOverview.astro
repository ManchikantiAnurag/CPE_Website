---
import type { CollectionEntry } from "astro:content";
import CourseSectionContent from "../CourseSectionContent/CourseSectionContent.astro";

interface Props {
    overview: string;
    sections?: CollectionEntry<"courses">["data"]["sections"];
}

const { overview, sections = [] } = Astro.props;
---

<div class="course-overview">
    <section class="course-section">
        <h2>Programme Overview</h2>
        <CourseSectionContent paragraphs={[overview]} items={[]} closing_paragraphs={[]} />
    </section>

    {
        sections.map((section) => (
            <section class="course-section">
                <h2>{section.heading}</h2>
                {(section.paragraphs.length > 0 || section.items.length > 0 || section.closing_paragraphs.length > 0) && (
                    <CourseSectionContent {...section} />
                )}
                {section.subsections.map((subsection) => (
                    <section class="course-subsection">
                        <h3>{subsection.heading}</h3>
                        <CourseSectionContent {...subsection} />
                    </section>
                ))}
            </section>
        ))
    }
</div>

<style>
    .course-overview,
    .course-section {
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    h2 {
        color: #0f172a;
        font-size: 32px;
        line-height: 40px;
    }

    .course-subsection {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    h3 {
        color: #475569;
        font-family: var(--font-sans);
        font-size: 18px;
        font-weight: 700;
        letter-spacing: normal;
        line-height: 24px;
    }

    @media (max-width: 639px) {
        h2 {
            font-size: 28px;
            line-height: 36px;
        }
    }
</style>
