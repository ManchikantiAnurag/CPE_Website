---
import Button from "../../Base/Button/Button.astro";
import Field from "../../Base/Field/Field.astro";
import Input from "../../Base/Input/Input.astro";
import Textarea from "../../Base/Textarea/Textarea.astro";

---

<form
    method="post"
    action="/api/form"
    data-toast="Thank you. Your message has been sent — we usually respond within one working day."
    class="grid gap-6 rounded-[20px] border border-border bg-card p-8 md:grid-cols-2 md:p-10"
>
    <div class="md:col-span-2">
        <h2 class="text-3xl text-primary md:text-[32px]">Send us a message</h2>
        <p class="mt-1 text-sm text-muted-foreground">
            We usually respond within one working day.
        </p>
    </div>

    <Field label="Name" for="name" required>
        <Input id="name" maxlength={100} required />
    </Field>

    <Field label="Mobile Number" for="mobile" required>
        <Input id="mobile" type="tel" maxlength={15} required />
    </Field>

    <Field label="Email" for="email">
        <Input id="email" type="email" maxlength={255} />
    </Field>

    <Field label="Subject" for="subject">
        <Input id="subject" maxlength={150} />
    </Field>

    <Field label="Message" for="message" required full>
        <Textarea id="message" maxlength={1000} required />
    </Field>

    <div class="md:col-span-2">
        <Button variant="accent" size="lg">Send Message</Button>
    </div>
</form>
