---
import SectionHeading from "../../Base/SectionHeading/SectionHeading.astro";
import Reveal from "../../Base/Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    items: { year: string; title: string; description: string }[];
}

const { eyebrow, title, items } = Astro.props;
---

<SectionHeading eyebrow={eyebrow} title={title} centered />

<Reveal
    as="ol"
    stagger={100}
    class="relative mt-14 space-y-10 before:absolute before:left-4 before:top-0 before:h-full before:w-px before:bg-slate-300 md:before:left-1/2"
>
    {
        items.map((item, index) => (
            <li class="relative grid items-center gap-x-10 pl-12 md:grid-cols-2 md:pl-0">
                <span class="absolute left-4 top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent md:left-1/2" />
                <div
                    class:list={[
                        index % 2 === 0
                            ? "md:col-start-2 md:pl-10"
                            : "md:col-start-1 md:row-start-1 md:pr-10 md:text-right",
                    ]}
                >
                    <span
                        class:list={[
                            "inline-block rounded px-4 py-1.5 text-lg font-semibold",
                            index % 2 === 0
                                ? "bg-accent text-accent-foreground"
                                : "border border-accent bg-accent/10 text-accent",
                        ]}
                    >
                        {item.year}
                    </span>
                    <h3 class="mt-3 font-sans text-lg font-semibold text-muted-foreground">
                        {item.title}
                    </h3>
                    <p class="mt-2 text-base leading-relaxed text-muted-foreground">
                        {item.description}
                    </p>
                </div>
            </li>
        ))
    }
</Reveal>
