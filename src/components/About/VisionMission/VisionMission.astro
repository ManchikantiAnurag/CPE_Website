---
import { Icon } from "astro-icon/components";
import Reveal from "../../Base/Reveal/Reveal.astro";
import OptimizedImage from "../../Base/OptimizedImage.astro";

interface Props {
    vision: { eyebrow: string; title: string; description: string };
    mission: { eyebrow: string; items: string[] };
    coreValues: { eyebrow: string; items: { name: string; description: string }[] };
    image: string;
    imageAlt: string;
}

const { vision, mission, coreValues, image, imageAlt } = Astro.props;
---

<div class="grid items-center gap-12 lg:grid-cols-2">
    <Reveal variant="left" stagger={90}>
        <h2 class="flex items-center gap-5 text-3xl leading-10 text-[#0F172A] md:text-4xl">
            <Icon name="lucide:goal" class="h-8 w-8 shrink-0 text-[#DC2626]" aria-hidden="true" />
            Our {mission.eyebrow}
        </h2>
        <ul class="mt-9 space-y-3 text-base leading-6 text-[#475569]">
            {
                mission.items.map((item) => (
                    <li class="flex gap-3.5">
                        <Icon name="lucide:check" class="mt-0.5 h-6 w-6 shrink-0 text-[#DC2626]" aria-hidden="true" />
                        {item}
                    </li>
                ))
            }
        </ul>
    </Reveal>

    <Reveal variant="right">
        <div class="aspect-[101/98] overflow-hidden rounded-lg shadow-sm">
            <OptimizedImage
                src={image}
                alt={imageAlt}
                width={1200}
                sizes="(min-width: 1024px) 42vw, 100vw"
                class="h-full w-full scale-[1.025] object-cover"
            />
        </div>
    </Reveal>
</div>

<div class="mt-14 grid items-start gap-12 lg:mt-20 lg:grid-cols-[380px_1fr]">
    <Reveal variant="left" stagger={90}>
        <h2 class="flex items-center gap-5 text-3xl leading-10 text-[#0F172A] md:text-4xl">
            <Icon name="lucide:eye" class="h-8 w-8 shrink-0 text-[#DC2626]" aria-hidden="true" />
            Our {vision.eyebrow}
        </h2>
        <p class="mt-6 text-base leading-6 text-[#475569]">{vision.title}</p>
        {vision.description && <p class="mt-3 text-base leading-6 text-[#475569]">{vision.description}</p>}
    </Reveal>

    <Reveal variant="right" stagger={90}>
        <h2 class="flex items-center gap-5 text-3xl leading-10 text-[#0F172A] md:text-4xl">
            <Icon name="lucide:gem" class="h-8 w-8 shrink-0 text-[#DC2626]" aria-hidden="true" />
            {coreValues.eyebrow}
        </h2>
        <dl class="mt-6 space-y-1.5 text-base leading-6 text-[#475569]">
            {coreValues.items.map((value) => (
                <div class="grid gap-x-3 sm:grid-cols-[147px_1fr]">
                    <dt class="font-semibold sm:whitespace-nowrap">{value.name}:</dt>
                    <dd>{value.description}</dd>
                </div>
            ))}
        </dl>
    </Reveal>
</div>
