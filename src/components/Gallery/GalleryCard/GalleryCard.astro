---
import { Icon } from "astro-icon/components";
import Figure from "../../Base/Figure/Figure.astro";

interface Props {
    title: string;
    image?: string;
    imageAlt: string;
    /** When set the tile links out to the video instead of standing alone. */
    videoUrl?: string;
}

const { title, image, imageAlt, videoUrl } = Astro.props;

const Wrapper = videoUrl ? "a" : "div";
---

<Wrapper
    href={videoUrl || undefined}
    target={videoUrl ? "_blank" : undefined}
    rel={videoUrl ? "noreferrer" : undefined}
    class="group relative block overflow-hidden"
>
    <Figure
        src={image}
        alt={imageAlt}
        width={800}
        height={880}
        class="aspect-[404/444] transition-transform duration-500 group-hover:scale-105"
    />
    {
        videoUrl && (
            <span class="absolute inset-0 flex items-center justify-center bg-navy-deep/40 text-primary-foreground">
                <Icon name="lucide:play" class="h-10 w-10" aria-hidden="true" />
            </span>
        )
    }
    <p class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-5 pt-12 text-sm font-medium text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        {title}
    </p>
</Wrapper>
