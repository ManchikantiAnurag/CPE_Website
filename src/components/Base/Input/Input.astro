---
interface Props {
    id: string;
    name?: string;
    type?: string;
    maxlength?: number;
    required?: boolean;
}

const { id, name, type = "text", maxlength, required = false } = Astro.props;
---

<input
    id={id}
    name={name ?? id}
    type={type}
    maxlength={maxlength}
    required={required}
    class="flex h-12 w-full rounded-[5px] border-[0.5px] border-[#aeaeae] bg-white px-5 py-1 text-lg transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring md:h-11"
/>
