---
import { Icon } from "astro-icon/components";
import ContactLink from "../ContactLink/ContactLink.astro";

interface Props {
    title: string;
    addressLines: string[];
    phones: string[];
    emails: string[];
}

const { title, addressLines, phones, emails } = Astro.props;
---

<div>
    <h4 class="footer-heading">{title}</h4>
    <ul class="mt-4 flex flex-col gap-4 text-sm leading-5 text-[#cbd5e1]">
        {
            addressLines.length > 0 && (
                <li class="flex gap-3">
                    <Icon
                        name="lucide:map-pin"
                        class="mt-0.5 h-4 w-4 shrink-0 text-[#ef4444]"
                        aria-hidden="true"
                    />
                    <span class="leading-[23px]">{addressLines.join(", ")}</span>
                </li>
            )
        }
        {
            phones.length > 0 && (
                <li class="flex gap-3">
                    <Icon
                        name="lucide:phone"
                        class="mt-0.5 h-4 w-4 shrink-0 text-[#ef4444]"
                        aria-hidden="true"
                    />
                    <span class="flex flex-col">
                        {phones.map((phone) => (
                            <ContactLink
                                type="phone"
                                value={phone}
                                showIcon={false}
                                class="transition-colors hover:text-white"
                            />
                        ))}
                    </span>
                </li>
            )
        }
        {
            emails.map((email) => (
                <li class="flex items-center gap-3">
                    <Icon
                        name="lucide:mail"
                        class="h-4 w-4 shrink-0 text-[#ef4444]"
                        aria-hidden="true"
                    />
                    <ContactLink
                        type="email"
                        value={email}
                        showIcon={false}
                        class="break-all transition-colors hover:text-white"
                    />
                </li>
            ))
        }
    </ul>
</div>
