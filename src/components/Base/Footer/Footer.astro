---
import Logo from "../Logo/Logo.astro";
import SocialLinks from "../SocialLinks/SocialLinks.astro";
import FooterColumn from "./FooterColumn.astro";
import FooterContact from "./FooterContact.astro";
import {
    getContactDetails,
    getCourseLinks,
    getFooterNoteLinks,
    getPrimaryNavigation,
    getSiteSettings,
} from "../../../lib/site";

const site = await getSiteSettings();
const contact = await getContactDetails();
const quickLinks = await getPrimaryNavigation();
const courses = await getCourseLinks();
const noteLinks = await getFooterNoteLinks();

const addressLines = [
    contact.address.line1,
    contact.address.line2,
    contact.address.line3,
].filter((line): line is string => Boolean(line));

const year = new Date().getFullYear();
---

<footer class="bg-navy-deep text-primary-foreground">
    <div
        class="mx-auto grid max-w-[1328px] gap-10 px-6 py-16 md:grid-cols-2 lg:grid-cols-[1.5fr_0.7fr_1.1fr_1.1fr]"
    >
        <div>
            <div class="inline-block rounded bg-background p-3 text-primary">
                <Logo
                    src={site.logo}
                    alt={site.logo_alt}
                    fallbackText={site.college_name}
                    class="h-14"
                />
            </div>
            <p class="mt-5 max-w-xs text-sm leading-relaxed opacity-75">
                {site.description}
            </p>
            <SocialLinks links={contact.social_links} class="mt-5" />
        </div>

        <FooterColumn title="Quick Links" links={quickLinks} />
        <FooterColumn title="Courses" links={courses} joinDescription />
        <FooterContact
            title="Contact"
            addressLines={addressLines}
            phones={contact.phone_numbers}
            emails={contact.emails}
        />
    </div>

    <div class="border-t border-primary-foreground/10">
        <div
            class="mx-auto flex max-w-[1328px] flex-col gap-2 px-6 py-5 text-xs opacity-70 md:flex-row md:items-center md:justify-between"
        >
            <p>
                © {year} {site.college_name}, {site.institution_name}. All rights
                reserved.
            </p>
            <p>
                Affiliated to {site.affiliation}
                {
                    noteLinks.map((link) => (
                        <>
                            {" · "}
                            <a href={link.href} class="hover:text-accent">
                                {link.label}
                            </a>
                        </>
                    ))
                }
            </p>
        </div>
    </div>
</footer>
