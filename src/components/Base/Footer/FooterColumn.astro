---
import type { NavLink } from "../../../lib/site";

interface Props {
    title: string;
    links: NavLink[];
    /** Course links read better as "CODE — Full title". */
    joinDescription?: boolean;
}

const { title, links, joinDescription = false } = Astro.props;
---

<div>
    <h4 class="text-sm font-semibold uppercase tracking-[0.14em]">{title}</h4>
    <ul class="mt-5 space-y-2.5 text-sm opacity-80">
        {
            links.map((link) => (
                <li>
                    <a href={link.href} class="hover:text-accent">
                        {joinDescription && link.description
                            ? `${link.label} — ${link.description}`
                            : link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>
