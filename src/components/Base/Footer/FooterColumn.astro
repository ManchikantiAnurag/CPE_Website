---
import type { NavLink } from "../../../lib/site";

interface Props {
    title: string;
    links: NavLink[];
    /** Course links read better as "CODE — Full title". */
    joinDescription?: boolean;
    /** Gap between list items (Tailwind class). */
    gap?: string;
}

const { title, links, joinDescription = false, gap = "gap-2.5" } = Astro.props;
---

<div>
    <h4 class="footer-heading">{title}</h4>
    <ul class:list={["mt-4 flex flex-col text-sm leading-5 text-[#cbd5e1]", gap]}>
        {
            links.map((link) => (
                <li>
                    <a href={link.href} class="transition-colors hover:text-white">
                        {joinDescription && link.description
                            ? `${link.label} — ${link.description}`
                            : link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>
