---
import { Icon } from "astro-icon/components";

interface Props {
    icon: string;
    term: string;
    description: string;
}

const { icon, term, description } = Astro.props;
---

<div class="flex gap-3">
    <Icon
        name={icon}
        class="mt-0.5 h-6 w-6 shrink-0 text-accent"
        aria-hidden="true"
    />
    <div>
        <dt class="text-lg font-semibold uppercase text-muted-foreground">
            {term}
        </dt>
        <dd class="mt-2.5 text-base text-muted-foreground">{description}</dd>
    </div>
</div>
