---
import PersonCard from "../PersonCard/PersonCard.astro";
import Reveal from "../Reveal/Reveal.astro";

interface Props {
    people: { name: string; role: string; bio: string; photo?: string }[];
    class?: string;
}

const { people, class: className } = Astro.props;
---

<Reveal
    stagger={110}
    variant="zoom"
    class={["grid gap-6 md:grid-cols-3", className]}
>
    {
        people.map((person) => (
            <PersonCard
                name={person.name}
                role={person.role}
                bio={person.bio}
                photo={person.photo}
            />
        ))
    }
</Reveal>
