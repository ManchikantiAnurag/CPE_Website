---
import { Icon } from "astro-icon/components";

interface Props {
    items: string[];
    icon?: string;
    class?: string;
}

const {
    items,
    icon = "lucide:circle-check",
    class: className,
} = Astro.props;
---

<ul class:list={["grid gap-3 sm:grid-cols-2", className]}>
    {
        items.map((item) => (
            <li class="flex gap-3 border border-border bg-card p-4 text-sm text-foreground/85">
                <Icon
                    name={icon}
                    class="mt-0.5 h-4 w-4 shrink-0 text-brand-green"
                    aria-hidden="true"
                />
                {item}
            </li>
        ))
    }
</ul>
