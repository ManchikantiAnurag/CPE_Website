---
import OptimizedImage from "../OptimizedImage.astro";

interface Props {
    name: string;
    role: string;
    bio: string;
    photo?: string;
}

const { name, role, bio, photo } = Astro.props;
---

<article class="flex h-full flex-col border border-border bg-card">
    <div class="aspect-[4/3] overflow-hidden bg-surface">
        {
            photo ? (
                <OptimizedImage
                    src={photo}
                    alt={name}
                    width={800}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="h-full w-full object-cover"
                />
            ) : (
                <div
                    class="flex h-full items-center justify-center font-display text-4xl text-border"
                    aria-hidden="true"
                >
                    {name.charAt(0)}
                </div>
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-6">
        <h3 class="text-lg text-primary">{name}</h3>
        <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-accent">
            {role}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{bio}</p>
    </div>
</article>
