---
import OptimizedImage from "../OptimizedImage.astro";

interface Props {
    name: string;
    role: string;
    bio: string;
    photo?: string;
}

const { name, role, bio, photo } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-lg border border-border bg-card">
    <div class="aspect-[8/5] overflow-hidden border-b border-border/50 bg-[#F1F5F9]">
        {
            photo ? (
                <OptimizedImage
                    src={photo}
                    alt={name}
                    width={800}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    loading="lazy"
                    class="h-full w-full object-cover"
                />
            ) : (
                <div
                    class="flex h-full items-center justify-center font-display text-[64px] text-[#CBD5E1]"
                    aria-hidden="true"
                >
                    {name.charAt(0)}
                </div>
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-6">
        <h3 class="text-lg text-primary">{name}</h3>
        <p class="mt-2 text-xs font-semibold uppercase tracking-[0.6px] text-[#DC2626]">
            {role}
        </p>
        <p class="mt-5 text-sm leading-5 text-[#475569]">{bio}</p>
    </div>
</article>
