---
interface Props {
    src?: string;
    alt: string;
    /** Shown when no logo image has been uploaded in the CMS yet. */
    fallbackText: string;
    class?: string;
}

const { src, alt, fallbackText, class: className } = Astro.props;
---

{
    src ? (
        <img src={src} alt={alt} class:list={["w-auto", className]} />
    ) : (
        <span class="font-display text-xl font-semibold tracking-tight">
            {fallbackText}
        </span>
    )
}
