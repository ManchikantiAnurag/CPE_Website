---
import OptimizedImage from "../OptimizedImage.astro";

interface Props {
    src?: string;
    alt: string;
    fallbackText: string;
    class?: string;
}

const { src, alt, fallbackText, class: className } = Astro.props;
---

{
    src ? (
        <OptimizedImage
            src={src}
            alt={alt}
            width={400}
            sizes="200px"
            loading="eager"
            class:list={["w-auto", className]}
        />
    ) : (
        <span class="font-display text-xl font-semibold tracking-tight">
            {fallbackText}
        </span>
    )
}
