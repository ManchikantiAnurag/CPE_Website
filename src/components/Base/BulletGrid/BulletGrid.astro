---
interface Props {
    items: string[];
    class?: string;
}

const { items, class: className } = Astro.props;
---

<!-- gap-px over a bordered background draws the hairline grid between cells. -->
<ul
    class:list={[
        "grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2",
        className,
    ]}
>
    {
        items.map((item) => (
            <li class="flex gap-4 bg-card p-7 text-sm leading-relaxed text-muted-foreground">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {item}
            </li>
        ))
    }
</ul>
