---
import Reveal from "../Reveal/Reveal.astro";

interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    centered?: boolean;
    /** Light type, for headings sitting on the navy ground. */
    inverse?: boolean;
    class?: string;
    as?: "h1" | "h2";
}

const {
    eyebrow,
    title,
    description,
    centered = false,
    inverse = false,
    class: className,
    as: Heading = "h2",
} = Astro.props;
---

<Reveal
    stagger={80}
    class={["max-w-3xl", centered && "mx-auto text-center", className]}
>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading
        class:list={[
            "mt-2 text-3xl md:text-4xl",
            inverse ? "text-primary-foreground" : "text-primary",
        ]}
    >
        {title}
    </Heading>
    {
        description && (
            <p
                class:list={[
                    "mt-4 text-base leading-relaxed",
                    inverse
                        ? "text-primary-foreground/75"
                        : "text-muted-foreground",
                ]}
            >
                {description}
            </p>
        )
    }
</Reveal>
