---
import Section from "../Section/Section.astro";
import Reveal from "../Reveal/Reveal.astro";

interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<Section background="background" padded={false} class="bg-hero py-16 md:py-20">
    <Reveal immediate stagger={90} duration={800}>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl text-black md:text-5xl">
        {title}
    </h1>
    {
        description && (
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-foreground">
                {description}
            </p>
        )
        }
    </Reveal>
</Section>
