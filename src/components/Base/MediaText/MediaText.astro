---
import Figure from "../Figure/Figure.astro";
import Reveal from "../Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    paragraphs: string[];
    image?: string;
    imageAlt: string;
    /** Which column the image sits in. Text always takes the wider column. */
    imagePosition?: "start" | "end";
}

const {
    eyebrow,
    title,
    paragraphs,
    image,
    imageAlt,
    imagePosition = "end",
} = Astro.props;

const imageFirst = imagePosition === "start";
const hasActions = Astro.slots.has("actions");
---

<div
    class:list={[
        "grid gap-12 lg:items-center",
        imageFirst ? "lg:grid-cols-[1fr_1.1fr]" : "lg:grid-cols-[1.1fr_1fr]",
    ]}
>
    {
        imageFirst && (
            <Reveal variant="left">
                <Figure src={image} alt={imageAlt} width={1408} height={1008} />
            </Reveal>
        )
    }

    <Reveal variant={imageFirst ? "right" : "left"} stagger={80}>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="mt-3 text-3xl text-primary md:text-4xl">{title}</h2>
        {
            paragraphs.map((paragraph, index) => (
                <p
                    class:list={[
                        index === 0 ? "mt-5" : "mt-4",
                        "text-base leading-relaxed text-muted-foreground",
                    ]}
                >
                    {paragraph}
                </p>
            ))
        }
        {
            hasActions && (
                <div class="mt-8 flex flex-wrap gap-3">
                    <slot name="actions" />
                </div>
            )
        }
    </Reveal>

    {
        !imageFirst && (
            <Reveal variant="right">
                <Figure src={image} alt={imageAlt} width={1408} height={1008} />
            </Reveal>
        )
    }
</div>
