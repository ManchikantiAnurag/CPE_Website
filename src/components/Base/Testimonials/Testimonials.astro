---
import SectionHeading from "../SectionHeading/SectionHeading.astro";
import Reveal from "../Reveal/Reveal.astro";

interface Props {
    eyebrow: string;
    title: string;
    items: { quote: string; name: string; role: string }[];
}

const { eyebrow, title, items } = Astro.props;
---

<SectionHeading eyebrow={eyebrow} title={title} centered />

<Reveal stagger={100} class="mt-12 grid gap-6 md:grid-cols-3">
    {
        items.map((item) => (
            <figure class="flex flex-col justify-between rounded-lg border border-border bg-card p-8 shadow-sm">
                <blockquote>
                    <span class="block font-display text-3xl leading-none text-[#ef4444]" aria-hidden="true">“</span>
                    <p class="mt-4 text-sm leading-[23px] text-slate-700">{item.quote}</p>
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-3 border-t border-slate-100 pt-5">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 font-display text-base font-bold text-slate-700" aria-hidden="true">
                        {item.name.charAt(0)}
                    </span>
                    <div>
                        <p class="text-sm font-bold text-primary">{item.name}</p>
                        <p class="text-xs text-slate-500">{item.role}</p>
                    </div>
                </figcaption>
            </figure>
        ))
    }
</Reveal>
