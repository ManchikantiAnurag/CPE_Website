---
interface Props {
    id: string;
    name?: string;
    rows?: number;
    maxlength?: number;
    required?: boolean;
}

const { id, name, rows = 4, maxlength, required = false } = Astro.props;
---

<textarea
    id={id}
    name={name ?? id}
    rows={rows}
    maxlength={maxlength}
    required={required}
    class="flex min-h-[174px] w-full rounded-[5px] border-[0.5px] border-[#aeaeae] bg-white px-5 py-4 text-lg placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring "
></textarea>
