---
import ContactLink from "../ContactLink/ContactLink.astro";

interface Props {
    message: string;
    phone?: string;
    email?: string;
}

const { message, phone, email } = Astro.props;
---

<div class="hidden bg-navy-deep text-primary-foreground md:block">
    <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2 text-xs"
    >
        <p class="tracking-wide opacity-80">{message}</p>
        <div class="flex items-center gap-5">
            {phone && <ContactLink type="phone" value={phone} class="hover:opacity-80" />}
            {email && <ContactLink type="email" value={email} class="hover:opacity-80" />}
        </div>
    </div>
</div>
