---
import ContactLink from "../ContactLink/ContactLink.astro";

interface Props {
    message: string;
    phone?: string;
    email?: string;
}

const { message, phone, email } = Astro.props;
---

<div class="bg-navy-deep text-primary-foreground">
    <div
        class="mx-auto flex max-w-[1328px] flex-col items-center justify-between gap-2 px-4 py-2.5 text-center text-xs sm:px-6 md:flex-row md:gap-6 md:text-left"
    >
        <p class="tracking-wide opacity-80">{message}</p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 md:shrink-0">
            {phone && <ContactLink type="phone" value={phone} class="whitespace-nowrap hover:opacity-80" />}
            {email && <ContactLink type="email" value={email} class="whitespace-nowrap hover:opacity-80" />}
        </div>
    </div>
</div>
