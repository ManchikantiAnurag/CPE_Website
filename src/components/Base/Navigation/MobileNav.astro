---
import Button from "../Button/Button.astro";
import type { NavItem, NavLink } from "../../../lib/site";

interface Props {
    items: NavItem[];
    courses: NavLink[];
    currentPath: string;
    ctaLabel: string;
    ctaHref: string;
}

const { items, courses, currentPath, ctaLabel, ctaHref } = Astro.props;

const isActive = (href: string) =>
    href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<div
    id="mobile-nav"
    hidden
    class="border-t border-border bg-background lg:hidden"
>
    <nav class="mx-auto flex max-w-7xl flex-col px-6 py-3" aria-label="Mobile">
        {
            items.map((item) => (
                <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                        "border-b border-border/60 py-3 text-sm font-medium last:border-0",
                        isActive(item.href) ? "text-accent" : "text-foreground",
                    ]}
                >
                    {item.label}
                </a>
            ))
        }

        <div class="flex flex-wrap gap-2 py-3">
            {
                courses.map((course) => (
                    <a
                        href={course.href}
                        class="rounded border border-border px-3 py-1 text-xs font-semibold text-navy-soft"
                    >
                        {course.label}
                    </a>
                ))
            }
        </div>

        <Button href={ctaHref} variant="accent" class="mb-3 w-full">
            {ctaLabel}
        </Button>
    </nav>
</div>
