---
import { Icon } from "astro-icon/components";

interface Props {
    icon: string;
    title: string;
    /** Omit to supply richer content through the default slot instead. */
    description?: string;
    /** h2 where the card is a page-level landmark, h3 inside a section. */
    headingLevel?: "h2" | "h3";
    /** Roomier rounded card used on the contact page. */
    large?: boolean;
}

const {
    icon,
    title,
    description,
    headingLevel: Heading = "h3",
    large = false,
} = Astro.props;
---

<div class:list={["border border-border bg-card", large ? "rounded-[20px] p-[30px]" : "p-7"]}>
    <Icon name={icon} class:list={["text-accent", large ? "h-8 w-8" : "h-6 w-6"]} aria-hidden="true" />
    <Heading class:list={["text-primary", large ? "mt-3 text-3xl md:text-[32px]" : "mt-4 text-lg"]}>{title}</Heading>
    {
        description ? (
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {description}
            </p>
        ) : (
            <slot />
        )
    }
</div>
