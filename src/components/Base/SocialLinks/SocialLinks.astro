---
import { Icon } from "astro-icon/components";

interface Props {
    links: { platform: string; label: string; url: string }[];
    /** "inverse" sits on the navy footer, "light" on a white card. */
    variant?: "light" | "inverse" | "header" | "footer";
    class?: string;
}

const { links, variant = "inverse", class: className } = Astro.props;

const styles = {
    header: "flex h-[30px] w-[30px] items-center justify-center rounded bg-black text-white transition-colors hover:bg-accent",
    light: "border border-border p-2.5 text-primary hover:border-accent hover:text-accent",
    inverse:
        "rounded border border-primary-foreground/20 p-2 hover:border-accent hover:text-accent",
    footer:
        "flex h-9 w-9 items-center justify-center rounded border border-[#334155]/60 bg-[#132035] text-[#cbd5e1] transition-colors hover:border-accent hover:bg-accent hover:text-white",
};
---

{
    links.length > 0 && (
        <div class:list={["flex", variant === "header" || variant === "footer" ? "gap-2.5" : "gap-3", className]}>
            {links.map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    class={styles[variant]}
                >
                    <Icon
                        name={`lucide:${link.platform}`}
                        class="h-4 w-4"
                        aria-hidden="true"
                    />
                </a>
            ))}
        </div>
    )
}
