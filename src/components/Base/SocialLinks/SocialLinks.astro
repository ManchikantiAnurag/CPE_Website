---
import { Icon } from "astro-icon/components";

interface Props {
    links: { platform: string; label: string; url: string }[];
    class?: string;
}

const { links, class: className } = Astro.props;
---

{
    links.length > 0 && (
        <div class:list={["flex gap-3", className]}>
            {links.map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={link.label}
                    class="rounded border border-primary-foreground/20 p-2 hover:border-accent hover:text-accent"
                >
                    <Icon
                        name={`lucide:${link.platform}`}
                        class="h-4 w-4"
                        aria-hidden="true"
                    />
                </a>
            ))}
        </div>
    )
}
