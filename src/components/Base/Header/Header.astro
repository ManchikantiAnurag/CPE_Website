---
import { Icon } from "astro-icon/components";
import AnnouncementBar from "../AnnouncementBar/AnnouncementBar.astro";
import Logo from "../Logo/Logo.astro";
import Navigation from "../Navigation/Navigation.astro";
import MobileNav from "../Navigation/MobileNav.astro";
import SocialLinks from "../SocialLinks/SocialLinks.astro";
import {
    getContactDetails,
    getCourseLinks,
    getPrimaryNavigation,
    getSiteSettings,
} from "../../../lib/site";

interface Props {
    background?: "default" | "hero";
}

const { background = "default" } = Astro.props;
const site = await getSiteSettings();
const contact = await getContactDetails();
const items = await getPrimaryNavigation();
const courses = await getCourseLinks();

const currentPath = Astro.url.pathname;
const announcement = [
    site.institution_name,
    `Estd. ${site.established_year}`,
    `Affiliated to ${site.affiliation}`,
].join(" · ");
---

<header class="sticky top-0 z-50 w-full">
    <AnnouncementBar
        message={announcement}
        phone={contact.phone_numbers[0]}
        email={contact.emails[0]}
    />

    <div class:list={[
        background === "hero" ? "hero-navigation bg-hero" : "bg-hero",
    ]}>
        <div
            class:list={[
                "mx-auto flex max-w-[1600px] items-center justify-between gap-4 px-6",
                background === "hero" ? "py-6" : "py-3",
            ]}
        >
            <a href="/" class="flex shrink-0 items-center">
                <Logo
                    src={site.logo}
                    alt={site.logo_alt}
                    fallbackText={site.college_name}
                    class="h-12 md:h-14"
                />
            </a>

            <Navigation items={items} currentPath={currentPath} />

            <div class="flex shrink-0 items-center gap-2">
                <SocialLinks links={contact.social_links} variant="header" class="hidden min-[1360px]:flex" />
                <button
                    type="button"
                    id="mobile-nav-toggle"
                    class="rounded-md border border-border p-2 min-[1360px]:hidden"
                    aria-label="Toggle navigation"
                    aria-controls="mobile-nav"
                    aria-expanded="false"
                >
                    <Icon
                        name="lucide:menu"
                        class="h-5 w-5"
                        data-nav-icon="open"
                        aria-hidden="true"
                    />
                    <Icon
                        name="lucide:x"
                        class="hidden h-5 w-5"
                        data-nav-icon="close"
                        aria-hidden="true"
                    />
                </button>
            </div>
        </div>

        <MobileNav
            items={items}
            courses={courses}
            currentPath={currentPath}
        />
    </div>
</header>

<style>
    .hero-navigation {
        background-size: 100% 820px;
        background-position: center -160px;
    }
</style>

<script>
    const toggle = document.getElementById("mobile-nav-toggle");
    const panel = document.getElementById("mobile-nav");

    toggle?.addEventListener("click", () => {
        const open = panel?.hasAttribute("hidden");

        if (open) panel?.removeAttribute("hidden");
        else panel?.setAttribute("hidden", "");

        toggle.setAttribute("aria-expanded", String(open));
        toggle
            .querySelector('[data-nav-icon="open"]')
            ?.classList.toggle("hidden", open);
        toggle
            .querySelector('[data-nav-icon="close"]')
            ?.classList.toggle("hidden", !open);
    });
</script>
