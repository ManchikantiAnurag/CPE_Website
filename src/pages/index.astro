---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Base/Section/Section.astro";
import HomeHero from "../components/Home/HomeHero/HomeHero.astro";
import AboutIntro from "../components/Home/AboutIntro/AboutIntro.astro";
import CoursesGrid from "../components/Home/CoursesGrid/CoursesGrid.astro";
import WhyChoose from "../components/Home/WhyChoose/WhyChoose.astro";
import CareerFocus from "../components/Home/CareerFocus/CareerFocus.astro";
import LeadershipGrid from "../components/Home/LeadershipGrid/LeadershipGrid.astro";
import CampusLife from "../components/Home/CampusLife/CampusLife.astro";
import EmptyStateSection from "../components/Home/EmptyStateSection/EmptyStateSection.astro";
import CtaBanner from "../components/Home/CtaBanner/CtaBanner.astro";
import { getContactDetails, getSection, resolvePhones } from "../lib/site";

const seo = await getSection("homeSeo");
const hero = await getSection("homeHero");
const about = await getSection("homeAbout");
const courses = await getSection("homeCourses");
const whyChoose = await getSection("homeWhyChoose");
const careerFocus = await getSection("homeCareerFocus");
const leadership = await getSection("homeLeadership");
const campusLife = await getSection("homeCampusLife");
const achievements = await getSection("homeAchievements");
const banner = await getSection("homeAdmissionsBanner");
const news = await getSection("homeNews");

const contact = await getContactDetails();
const bannerPhones = resolvePhones(banner.phones, contact.phone_numbers);
---

<Layout title={seo.meta_title} description={seo.meta_description}>
    <HomeHero
        eyebrow={hero.eyebrow}
        title={hero.title}
        intro={hero.intro}
        primaryCta={hero.primary_cta}
        secondaryCta={hero.secondary_cta}
        stats={hero.stats}
        image={hero.image}
        imageAlt={hero.image_alt}
        badge={hero.badge}
    />

    <Section>
        <AboutIntro
            eyebrow={about.eyebrow}
            title={about.title}
            paragraphs={about.paragraphs}
            cta={about.cta}
            image={about.image}
            imageAlt={about.image_alt}
        />
    </Section>

    <Section id="courses" background="surface">
        <CoursesGrid
            eyebrow={courses.eyebrow}
            title={courses.title}
            description={courses.description}
            cta={courses.cta}
        />
    </Section>

    <Section>
        <WhyChoose
            eyebrow={whyChoose.eyebrow}
            title={whyChoose.title}
            items={whyChoose.items}
        />
    </Section>

    <Section background="navy">
        <CareerFocus
            eyebrow={careerFocus.eyebrow}
            title={careerFocus.title}
            description={careerFocus.description}
            items={careerFocus.items}
        />
    </Section>

    <Section background="surface">
        <LeadershipGrid
            eyebrow={leadership.eyebrow}
            title={leadership.title}
            cta={leadership.cta}
            people={leadership.people}
        />
    </Section>

    <Section>
        <CampusLife
            eyebrow={campusLife.eyebrow}
            title={campusLife.title}
            description={campusLife.description}
            primaryCta={campusLife.primary_cta}
            secondaryCta={campusLife.secondary_cta}
            image={campusLife.image}
            imageAlt={campusLife.image_alt}
        />
    </Section>

    <Section>
        <EmptyStateSection
            eyebrow={achievements.eyebrow}
            title={achievements.title}
            description={achievements.description}
            cta={achievements.cta}
            emptyMessage={achievements.empty_message}
        />
    </Section>

    <CtaBanner
        kicker={banner.kicker}
        title={banner.title}
        description={banner.description}
        phones={bannerPhones}
        cta={banner.cta}
    />

    <Section background="surface">
        <EmptyStateSection
            eyebrow={news.eyebrow}
            title={news.title}
            description={news.description}
            cta={news.cta}
            emptyMessage={news.empty_message}
        />
    </Section>
</Layout>
