---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/Base/PageHero/PageHero.astro";
import Section from "../components/Base/Section/Section.astro";
import { getSection } from "../lib/site";

const seo = await getSection("downloadsSeo");
const hero = await getSection("downloadsHero");
const downloads = await getSection("downloadsPage");
---

<Layout title={seo.meta_title} description={seo.meta_description}>
    <PageHero slot="hero" eyebrow={hero.eyebrow} title={hero.title} description={hero.intro} />
    <Section>
        {downloads.items.length ? (
            <ul class="grid gap-6 md:grid-cols-2">
                {downloads.items.map(item => (
                    <li class="rounded-lg border border-border bg-surface p-6">
                        <h2 class="text-2xl"><a href={item.file} class="underline decoration-accent underline-offset-4" download>{item.title}</a></h2>
                        {item.description && <p class="mt-3 leading-relaxed">{item.description}</p>}
                    </li>
                ))}
            </ul>
        ) : <p class="text-muted-foreground">{downloads.empty_message}</p>}
    </Section>
</Layout>
