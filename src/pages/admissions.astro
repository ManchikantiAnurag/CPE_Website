---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/Base/PageHero/PageHero.astro";
import Section from "../components/Base/Section/Section.astro";
import Reveal from "../components/Base/Reveal/Reveal.astro";
import SectionHeading from "../components/Base/SectionHeading/SectionHeading.astro";
import AdmissionsCallout from "../components/Admissions/AdmissionsCallout/AdmissionsCallout.astro";
import AdmissionsProcess from "../components/Admissions/AdmissionsProcess/AdmissionsProcess.astro";
import AdmissionsChecklist from "../components/Admissions/AdmissionsChecklist/AdmissionsChecklist.astro";
import AdmissionsDates from "../components/Admissions/AdmissionsDates/AdmissionsDates.astro";
import AdmissionsProspectus from "../components/Admissions/AdmissionsProspectus/AdmissionsProspectus.astro";
import EnquiryForm from "../components/Admissions/EnquiryForm/EnquiryForm.astro";
import {
    getContactDetails,
    getCourseLinks,
    getSection,
    resolvePhones,
} from "../lib/site";

const seo = await getSection("admissionsSeo");
const hero = await getSection("admissionsHero");
const callout = await getSection("admissionsCallout");
const process = await getSection("admissionsProcess");
const eligibility = await getSection("admissionsEligibility");
const documents = await getSection("admissionsDocuments");
const dates = await getSection("admissionsDates");
const prospectus = await getSection("admissionsProspectus");
const enquiry = await getSection("admissionsEnquiry");

const contact = await getContactDetails();
const phones = resolvePhones(callout.phones, contact.phone_numbers);

const courseOptions = (await getCourseLinks()).map((course) => ({
    value: course.label,
    label: `${course.label} — ${course.description}`,
}));

const { footnote } = enquiry;
---

<Layout title={seo.meta_title} description={seo.meta_description}>
    <Section id="enquiry" background="surface">
        <div class="mx-auto max-w-3xl">
            <SectionHeading
                as="h1"
                eyebrow={enquiry.eyebrow}
                title={enquiry.title}
                description={enquiry.description}
                centered
            />

            <Reveal class="mt-10">
                <EnquiryForm
                    title={enquiry.form_title}
                    description={enquiry.form_description}
                    submitLabel={enquiry.submit_label}
                    courses={courseOptions}
                    action={enquiry.form_endpoint}
                />
            </Reveal>

            <p class="mt-6 text-center text-sm text-muted-foreground">
                {footnote.text}{" "}
                <a href={footnote.link_href} class="font-semibold text-accent">
                    {footnote.link_label}
                </a>{" "}
                {footnote.call_prefix} {contact.phone_numbers.join(" / ")}.
            </p>
        </div>
    </Section>
</Layout>
