---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Base/Section/Section.astro";
import CourseRow from "../../components/Courses/CourseRow/CourseRow.astro";
import Reveal from "../../components/Base/Reveal/Reveal.astro";
import { getCareerNames, getSection } from "../../lib/site";

const seo = await getSection("coursesSeo");
const hero = await getSection("coursesHero");

const courses = await Promise.all(
    (await getCollection("courses"))
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (course) => ({
            ...course.data,
            href: `/courses/${course.id}`,
            careerNames: await getCareerNames(course.data.careers),
        })),
);
---

<Layout title={seo.meta_title} description={seo.meta_description} headerBackground="hero">
    <Section background="hero" padded={false} class="courses-hero pt-12 pb-16 md:pt-16 md:pb-[100px] [&>div]:max-w-[1298px]">
        <Reveal immediate stagger={90}>
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 class="mt-6 max-w-[800px] font-display text-4xl font-normal leading-tight text-black md:text-[56px] md:leading-[56px]">
                {hero.title}
            </h1>
            <p class="mt-8 max-w-[1100px] text-base leading-7 text-black md:text-lg">
                {hero.intro}
            </p>
        </Reveal>
    </Section>

    <Section padded={false} class="py-16 md:py-20 [&>div]:max-w-[1298px]">
        <Reveal stagger={120} class="grid gap-8 md:gap-12">
            {
                courses.map((course) => (
                    <CourseRow
                        code={course.display_code || course.code}
                        title={course.title}
                        tagline={course.tagline}
                        duration={course.duration}
                        eligibility={course.eligibility}
                        careers={course.careerNames}
                        href={course.href}
                    />
                ))
            }
        </Reveal>
    </Section>
</Layout>

<style>
    :global(.courses-hero) {
        background-size: 100% 820px;
        background-position: center -264px;
    }

    @media (max-width: 767px) {
        :global(.courses-hero) {
            background-size: cover;
            background-position: center;
        }
    }
</style>
