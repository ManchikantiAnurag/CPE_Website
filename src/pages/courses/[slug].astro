---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/Base/PageHero/PageHero.astro";
import CourseOverview from "../../components/Courses/CourseOverview/CourseOverview.astro";
import CourseSidebar from "../../components/Courses/CourseSidebar/CourseSidebar.astro";
import EnquiryForm from "../../components/Admissions/EnquiryForm/EnquiryForm.astro";
import Reveal from "../../components/Base/Reveal/Reveal.astro";
import { getCourseLinks, getSection } from "../../lib/site";

export async function getStaticPaths() {
    const courses = await getCollection("courses");
    return courses.map(({ id }) => ({ params: { slug: id } }));
}

const entry = await getEntry("courses", Astro.params.slug!);
const course = entry.data;

const contactDetails = await getEntry("contactDetails", "contact-details");
const phones = course.enquiry_phones.length
    ? course.enquiry_phones
    : (contactDetails?.data.phone_numbers ?? []);
const enquiry = await getSection("admissionsEnquiry");
const courseOptions = (await getCourseLinks()).map((item) => ({
    value: item.label,
    label: `${item.label} — ${item.description}`,
}));
---

<Layout title={course.title} description={course.tagline} headerBackground="hero">
    <PageHero
        eyebrow={course.display_code || course.code}
        title={course.title}
        description={course.tagline}
        variant="course"
    />

    <section class="course-content">
        <div class="course-container course-columns">
            <Reveal variant="left" class="min-w-0">
                <CourseOverview
                    overview={course.overview}
                    sections={course.sections}
                />
            </Reveal>
            <Reveal variant="right" delay={120} class="min-w-0">
                <CourseSidebar
                    duration={course.duration}
                    eligibility={course.eligibility}
                    board={course.board}
                    phones={phones}
                />
            </Reveal>
        </div>
    </section>

    <section id="enquiry" class="course-enquiry-section">
        <div class="course-container">
            <div class="mx-auto max-w-[960px]">
                <Reveal>
                    <EnquiryForm
                        title={enquiry.form_title}
                        description={enquiry.form_description}
                        submitLabel={enquiry.submit_label}
                        courses={courseOptions}
                        action={enquiry.form_endpoint}
                        variant="course"
                    />
                </Reveal>
            </div>
        </div>
    </section>
</Layout>

<style>
    .course-container {
        width: min(100% - 48px, 1269px);
        margin-inline: auto;
    }

    .course-content {
        padding-block: 68px 88px;
    }

    .course-columns {
        display: grid;
        grid-template-columns: minmax(0, 712fr) minmax(0, 492fr);
        align-items: start;
        gap: 65px;
    }

    .course-enquiry-section {
        padding-block: 96px;
        background: #fffce7;
        scroll-margin-top: 160px;
    }

    @media (min-width: 1320px) {
        .course-content {
            padding-left: 15px;
        }
    }

    @media (max-width: 1023px) {
        .course-columns {
            grid-template-columns: minmax(0, 1fr);
            gap: 40px;
        }

        .course-content,
        .course-enquiry-section {
            padding-block: 48px;
        }
    }
</style>
